<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DXSpotViewer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:DXSpotViewer.Views"
    xmlns:pages="clr-namespace:DXSpotViewer"
    Shell.FlyoutBehavior="Disabled">

    <!-- ✅ Login Page (in Views folder) -->
    <ShellContent
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- ✅ Main App (with tabs) -->
    <TabBar Route="MainPage">
        <!-- ✅ FIXED: MainPage is in root namespace, not Views -->
        <ShellContent
            Title="Spots"
            ContentTemplate="{DataTemplate pages:MainPage}"
            Route="SpotsTab" />

        <!-- ✅ SettingsPage is in Views folder -->
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsTab" />
        <ShellContent
            Title="Instructions"
            ContentTemplate="{DataTemplate views:InstructionsPage}"
            Route="InstructionsTab" />
    </TabBar>

</Shell>