<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DXSpotViewer.Views.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="6">

            <!-- Current User -->
            <Frame BackgroundColor="{DynamicResource Primary}" Padding="8" CornerRadius="6">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="User: " TextColor="White" FontSize="14" VerticalOptions="Center"/>
                    <Label Grid.Column="1" x:Name="CurrentUserLabel" Text="" FontSize="15" 
                           FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Notification Settings -->
            <Frame Padding="8" BorderColor="{DynamicResource Primary}" HasShadow="True" CornerRadius="6">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Notifications" FontSize="15" FontAttributes="Bold" TextColor="#2c3e50" Margin="0,0,0,2"/>

                    <!-- Row 1: Vibration + Sound -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Vibration -->
                        <Frame Grid.Column="0" Padding="6,4" CornerRadius="4" 
                               x:Name="VibrationFrame" BackgroundColor="#ffebee" BorderColor="#e0e0e0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Vibration" FontSize="13" TextColor="#c62828" 
                                       FontAttributes="Bold" VerticalOptions="Center"/>
                                <Switch Grid.Column="1" x:Name="VibrationSwitch" IsToggled="True" 
                                        Toggled="OnVibrationToggled" VerticalOptions="Center"
                                        OnColor="#4caf50" 
                                        ThumbColor="#ffffff"
                                        Scale="1.3"/>
                            </Grid>
                        </Frame>
                        <!-- Sound -->
                        <Frame Grid.Column="1" Padding="6,4" CornerRadius="4"
                               x:Name="SoundFrame" BackgroundColor="#ffebee" BorderColor="#e0e0e0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Sound" FontSize="13" TextColor="#c62828" 
                                       FontAttributes="Bold" VerticalOptions="Center"/>
                                <Switch Grid.Column="1" x:Name="SoundSwitch" IsToggled="True" 
                                        Toggled="OnSoundToggled" VerticalOptions="Center"
                                        OnColor="#4caf50"
                                        ThumbColor="#ffffff"
                                        Scale="1.3"/>
                            </Grid>
                        </Frame>
                    </Grid>

                    <!-- Row 2: TTS + STN -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                        <!-- TTS -->
                        <Frame Grid.Column="0" Padding="6,4" CornerRadius="4"
                               x:Name="TtsFrame" BackgroundColor="#e3f2fd" BorderColor="#e0e0e0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Voice (TTS)" FontSize="13" TextColor="#1565c0" 
                                       FontAttributes="Bold" VerticalOptions="Center"/>
                                <Switch Grid.Column="1" x:Name="TtsSwitch" IsToggled="False" 
                                        Toggled="OnTtsToggled" VerticalOptions="Center"
                                        OnColor="#2196f3"
                                        ThumbColor="#ffffff"
                                        Scale="1.3"/>
                            </Grid>
                        </Frame>
                        <!-- STN -->
                        <Frame Grid.Column="1" Padding="6,4" CornerRadius="4"
                               x:Name="StnFrame" BackgroundColor="#fff3e0" BorderColor="#e0e0e0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="STN Alerts" FontSize="13" TextColor="#e65100" 
                                       FontAttributes="Bold" VerticalOptions="Center"/>
                                <Switch Grid.Column="1" x:Name="TypeSTNSwitch" IsToggled="True" 
                                        Toggled="OnTypeSTNToggled" VerticalOptions="Center"
                                        OnColor="#ff9800"
                                        ThumbColor="#ffffff"
                                        Scale="1.3"/>
                            </Grid>
                        </Frame>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#e0e0e0" Margin="0,4"/>

                    <!-- Row 3: Volume + Speed sliders -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,2,0,0">
                        <!-- Volume -->
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Volume" FontSize="12" TextColor="#1976d2" 
                                   FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Grid ColumnDefinitions="24,*,36" HeightRequest="36">
                                <Label Grid.Column="0" Text="🔈" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center"/>
                                <Slider Grid.Column="1" x:Name="VolumeSlider" 
                                        Minimum="0.1" Maximum="1" Value="0.7"
                                        MinimumTrackColor="#2196f3" 
                                        MaximumTrackColor="#cfd8dc" 
                                        ThumbColor="#1565c0"
                                        ValueChanged="OnVolumeChanged"
                                        VerticalOptions="Center"/>
                                <Label Grid.Column="2" x:Name="VolumeLabel" Text="70%" FontSize="12" 
                                       TextColor="#1976d2" FontAttributes="Bold" 
                                       VerticalOptions="Center" HorizontalOptions="End"/>
                            </Grid>
                        </VerticalStackLayout>
                        <!-- Speed -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Voice Speed" FontSize="12" TextColor="#7b1fa2" 
                                   FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Grid ColumnDefinitions="24,*,36" HeightRequest="36">
                                <Label Grid.Column="0" Text="🐢" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center"/>
                                <Slider Grid.Column="1" x:Name="SpeedSlider" 
                                        Minimum="0.5" Maximum="1.5" Value="0.8"
                                        MinimumTrackColor="#9c27b0" 
                                        MaximumTrackColor="#cfd8dc" 
                                        ThumbColor="#6a1b9a"
                                        ValueChanged="OnSpeedChanged"
                                        VerticalOptions="Center"/>
                                <Label Grid.Column="2" x:Name="SpeedLabel" Text="0.8x" FontSize="12" 
                                       TextColor="#7b1fa2" FontAttributes="Bold" 
                                       VerticalOptions="Center" HorizontalOptions="End"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- Connection Status -->
            <Frame Padding="6" HasShadow="True" CornerRadius="6" BackgroundColor="#f5f5f5">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" HeightRequest="26">
                    <Frame Grid.Column="0" Padding="0" WidthRequest="16" HeightRequest="16" 
                           CornerRadius="8" HasShadow="False" BorderColor="Transparent"
                           x:Name="ConnectionFrame" BackgroundColor="#f44336">
                        <BoxView x:Name="ConnectionIndicator" Color="#f44336"/>
                    </Frame>
                    <Label Grid.Column="1" Text="MQTT:" FontSize="13" FontAttributes="Bold" 
                           TextColor="#37474f" VerticalOptions="Center"/>
                    <Label Grid.Column="2" x:Name="ConnectionStatusLabel" Text="Disconnected" 
                           FontSize="13" TextColor="#78909c" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Topic -->
            <Label x:Name="TopicLabel" Text="" FontSize="10" TextColor="#90a4ae" 
                   Margin="4,0" LineBreakMode="WordWrap"/>

            <!-- Buttons Row 1 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Text="Change Login" FontSize="12" HeightRequest="38" Padding="6,10"
                        CornerRadius="6" Clicked="OnChangeCredentialsClicked"/>
                <Button Grid.Column="1" Text="Logout" FontSize="12" HeightRequest="38" Padding="6,10"
                        CornerRadius="6" BackgroundColor="#e53935" TextColor="White" Clicked="OnLogoutClicked"/>
            </Grid>

            <!-- Buttons Row 2 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Text="Battery" FontSize="12" HeightRequest="38" Padding="6,10"
                        CornerRadius="6" BackgroundColor="#43a047" TextColor="White" 
                        Clicked="OnRequestBatteryOptimizationClicked"/>
                <Button Grid.Column="1" Text="🔊 Test Alert" FontSize="12" HeightRequest="38" Padding="6,10"
                        CornerRadius="6" BackgroundColor="#8e24aa" TextColor="White" 
                        Clicked="OnTestAlertsClicked"/>
            </Grid>

            <!-- Version -->
            <Label x:Name="VersionLabel" Text="Version 1.0" FontSize="10" TextColor="#bdbdbd" 
                   HorizontalOptions="Center" Margin="0,2,0,6"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>