<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<connectionStrings>
		<!-- Matches the template key read by AppSettingsBase.SetSQLServer() -->
		<add name="SQLServerConnectionStringTemplate"
			 connectionString="data source = {SQLServer}; initial catalog = QSOLOG; integrated security = True; MultipleActiveResultSets=true;" />
	</connectionStrings>

	<appSettings>
		<!-- SQL Server instance per host (Environment.MachineName → Hosts enum) -->
		<add key="SQLServer_PPS"   value="PPS" />
		<add key="SQLServer_HP"    value="PPS" />
		<add key="SQLServer_P510"  value="PPS" />
		<add key="SQLServer_R500A" value="PPS" />

		<!-- ROOT_DIR per host (required by AppSettingsBase constructor) -->
		<add key="ROOT_DIR_PPS"   value="C:\_DEPLOYED_APPS\VA3TNM" />
		<add key="ROOT_DIR_P510"  value="C:\_DEPLOYED_APPS\VA3TNM" />
		<add key="ROOT_DIR_HP"    value="C:\_DEPLOYED_APPS\VA3TNM" />
		<add key="ROOT_DIR_R500A" value="C:\_DEPLOYED_APPS\VA3TNM" />

		<!-- CC User / RBN listener defaults (overridable from GUI) -->
		<add key="CCUser_Host"     value="127.0.0.1" />
		<add key="CCUser_Port"     value="7300" />
		<add key="CCUser_Callsign" value="VE3ZR" />
	</appSettings>

</configuration>