<Window x:Class="CCSpotViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CCSpotViewer.ViewModels"
        Title="CC User Spot Viewer" Height="720" Width="1280"
        Background="#1E1E2E" Foreground="#CDD6F4">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Base styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="CaretBrush" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="RowBackground" Value="#181825"/>
            <Setter Property="AlternatingRowBackground" Value="#1E1E2E"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Connection bar -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="160"/>
            <!-- Log panels -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Connection bar ── -->
        <Border Grid.Row="0" Background="#313244" BorderBrush="#45475A"
                BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Label Content="Host:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Width="130" Margin="2,0,12,0" VerticalContentAlignment="Center"/>

                <Label Content="Port:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Width="60" Margin="2,0,12,0" VerticalContentAlignment="Center"/>

                <Label Content="Callsign:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" Margin="2,0,16,0" VerticalContentAlignment="Center"/>

                <Button Content="{Binding ConnectButtonLabel}"
                        Command="{Binding ConnectCommand}"
                        Width="110" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="#A6E3A1"/>
                                    <Setter Property="Foreground" Value="#1E1E2E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Clear Spots"  Command="{Binding ClearSpotsCommand}" Margin="0,0,8,0"/>
                <Button Content="Clear Log"    Command="{Binding ClearLogCommand}"/>

                <!-- Connection indicator -->
                <Ellipse Width="12" Height="12" Margin="16,0,4,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#F38BA8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#A6E3A1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding IsConnected, Converter={x:Static vm:BoolToStatusConverter.Instance}}"
                           VerticalAlignment="Center" Foreground="#BAC2DE"/>
            </StackPanel>
        </Border>

        <!-- ── Row 1: Spot DataGrid ── -->
        <Border Grid.Row="1" BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
            <DataGrid ItemsSource="{Binding Spots}" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time"       Binding="{Binding Time}"            Width="70"/>
                    <DataGridTextColumn Header="Date"       Binding="{Binding Date}"            Width="100"/>
                    <DataGridTextColumn Header="Freq" 
                    Binding="{Binding Frequency, StringFormat={}{0:F1}}"   Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="  "      Width="10"/>
                    <DataGridTextColumn Header="DX Call"    Binding="{Binding DxCallsign}"      Width="60"/>
                    <DataGridTextColumn Header="Type"       Binding="{Binding Type}"        Width="50"/>
                    <DataGridTextColumn Header="Type"       Binding="{Binding SpotType}"        Width="40"/>
                    <DataGridTextColumn Header="Mode"    Binding="{Binding Mode}"      Width="30"/>
                    <DataGridTextColumn Header="Wpm"    Binding="{Binding Wpm}"      Width="30"/>
                    <DataGridTextColumn Header="Db"    Binding="{Binding Db}"      Width="30"/>
                    <DataGridTextColumn Header="Spotter"    Binding="{Binding SpotterCallsign}" Width="100"/>
                    <DataGridTextColumn Header="DxCQZ"      Binding="{Binding DxCqZone}"        Width="55"/>
                    <DataGridTextColumn Header="DxITU"     Binding="{Binding DxItuZone}"       Width="55"/>
                    <DataGridTextColumn Header="DxGrid"    Binding="{Binding DxGrid}"          Width="50"/>
                    <DataGridTextColumn Header="SpCQZ"      Binding="{Binding SpotterCqZone}"   Width="55"/>
                    <DataGridTextColumn Header="SpITU"      Binding="{Binding SpotterItuZone}"   Width="55"/>
                    <DataGridTextColumn Header="SpGrid"    Binding="{Binding SpotterGrid}"     Width="70"/>
                    <DataGridTextColumn Header="Origin"     Binding="{Binding OriginNode}"      Width="110"/>
                    <DataGridTextColumn Header="RX Node"    Binding="{Binding RxViaNode}"       Width="110"/>
                    <DataGridTextColumn Header="Hops"       Binding="{Binding Hops}"            Width="45"/>
                    <DataGridTextColumn Header="Activity"       Binding="{Binding Activity}"            Width="30"/>
                    <DataGridTextColumn Header="DxState"       Binding="{Binding SpotterState}"            Width="30"/>
                    <DataGridTextColumn Header="SpState"       Binding="{Binding DxState}"            Width="100"/>
                    <DataGridTextColumn Header="DxPfx"       Binding="{Binding DxDxccPrefix}"            Width="30"/>
                    <DataGridTextColumn Header="SpPfx"       Binding="{Binding SpotterDxccPrefix}"            Width="30"/>
                    <DataGridTextColumn Header="DxGrid"       Binding="{Binding DxGrid}"            Width="30"/>
                    <DataGridTextColumn Header="SpGrid"       Binding="{Binding SpotterGrid}"            Width="30"/>

                    <DataGridTextColumn Header="InternalId"   Binding="{Binding InternalIdentifier}"        Width="180"/>
                    <DataGridTextColumn Header="Coordinates"   Binding="{Binding Coordinates}"        Width="180"/>
                    <DataGridTextColumn Header="RoutingNode"   Binding="{Binding RoutingNode}"        Width="180"/>
                    <DataGridTextColumn Header="Comments"   Binding="{Binding Comments}"        Width="180"/>


                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Row 2: Log panels ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- App messages -->
            <Border Grid.Column="0" BorderBrush="#45475A" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="App Messages" Foreground="#89B4FA"
                               FontWeight="Bold" Margin="6,4"/>
                    <TextBox Grid.Row="1" Text="{Binding AppLog, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             x:Name="tbAppLog" Margin="4,0,4,4"/>
                </Grid>
            </Border>

            <!-- Error messages -->
            <Border Grid.Column="2" BorderBrush="#F38BA8" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Errors" Foreground="#F38BA8"
                               FontWeight="Bold" Margin="6,4"/>
                    <TextBox Grid.Row="1" Text="{Binding ErrorLog, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Foreground="#F38BA8"
                             x:Name="tbErrorLog" Margin="4,0,4,4"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>