<Application x:Class="DXSpotMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:DXSpotMonitor.Utilities"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Value Converters from Utilities namespace -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <utilities:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <utilities:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <utilities:BoolToMonitoringConverter x:Key="BoolToMonitoringConverter"/>
        <utilities:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <utilities:EmptyStringToBackgroundConverter x:Key="EmptyStringToBackgroundConverter"/>
    </Application.Resources>
</Application>