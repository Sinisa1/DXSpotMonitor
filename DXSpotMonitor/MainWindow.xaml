<Window x:Class="DXSpotMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DXSpotMonitor.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="DX Spot Monitor Service - Multi-User" 
        Height="900" Width="1020"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
        <Style x:Key="UppercaseTextBox" TargetType="TextBox">
            <Setter Property="CharacterCasing" Value="Upper"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with MQTT Connection Status -->
        <Border Grid.Row="0" 
                Background="#2c3e50" 
                CornerRadius="5" 
                Padding="10" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="📡 DX Spot Monitor Service" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusBadge}">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding IsMqttConnected, Converter={StaticResource BoolToColorConverter}}"/>
                        </Border.Background>
                        <TextBlock Foreground="White" FontWeight="Bold">
                            <Run Text="{Binding IsMqttConnected, Converter={StaticResource BoolToStatusConverter}, Mode=OneWay}"/>
                            <Run Text=" MQTT"/>
                        </TextBlock>
                    </Border>

                    <Border Style="{StaticResource StatusBadge}" Background="#3498db">
                        <TextBlock Foreground="White" FontWeight="Bold">
                            <Run Text="👥"/>
                            <Run Text="{Binding ActiveUsers, Mode=OneWay}"/>
                            <Run Text=" Users"/>
                        </TextBlock>
                    </Border>

                    <Border Style="{StaticResource StatusBadge}" Background="#9b59b6">
                        <TextBlock Foreground="White" FontWeight="Bold">
                            <Run Text="🎯"/>
                            <Run Text="{Binding TotalFilters, Mode=OneWay}"/>
                            <Run Text=" Filters"/>
                        </TextBlock>
                    </Border>

                    <Border Style="{StaticResource StatusBadge}">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding IsMonitoring, Converter={StaticResource BoolToColorConverter}}"/>
                        </Border.Background>
                        <TextBlock Foreground="White" FontWeight="Bold">
                            <Run Text="{Binding IsMonitoring, Converter={StaticResource BoolToMonitoringConverter}, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <Border Style="{StaticResource StatusBadge}">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding IsFileLoggingEnabled, Converter={StaticResource BoolToColorConverter}}"/>
                        </Border.Background>
                        <TextBlock Foreground="White" FontWeight="Bold">
                            <Run Text="📁"/>
                            <Run Text="{Binding IsFileLoggingEnabled, Converter={StaticResource BoolToStatusConverter}, ConverterParameter=Log, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="Connect" 
                            Command="{Binding ConnectMqttCommand}" 
                            Width="80" 
                            Margin="0,0,5,0"
                            IsEnabled="{Binding IsMqttConnected, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="Disconnect" 
                            Command="{Binding DisconnectMqttCommand}" 
                            Width="80"
                            IsEnabled="{Binding IsMqttConnected}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Control Panel -->
        <Border Grid.Row="1" 
                Background="#ecf0f1" 
                CornerRadius="5" 
                Padding="10" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="▶ Start Monitoring" 
                            Command="{Binding StartMonitoringCommand}" 
                            Width="140" Height="35"
                            Background="#27ae60" Foreground="White" FontWeight="Bold"
                            Margin="0,0,5,0"
                            IsEnabled="{Binding IsMonitoring, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="⏹ Stop" 
                            Command="{Binding StopMonitoringCommand}" 
                            Width="80" Height="35"
                            Background="#e74c3c" Foreground="White" FontWeight="Bold"
                            Margin="0,0,5,0"
                            IsEnabled="{Binding IsMonitoring}"/>
                    <Button Content="Check Now" 
                            Command="{Binding CheckNowCommand}" 
                            Width="100" Height="35"
                            Background="#3498db" Foreground="White"
                            Margin="0,0,5,0"/>
                    <Button Content="🔄 Reload" 
                            Command="{Binding ReloadFiltersCommand}" 
                            Width="100" Height="35"
                            Background="#95a5a6" Foreground="White"
                            ToolTip="Reload all users and filters from database"
                            Margin="0,0,5,0"/>
                    <Button Content="📁 Stop Log" 
                            Command="{Binding StopFileLoggingCommand}" 
                            Width="90" Height="35"
                            Background="#f39c12" Foreground="White"
                            ToolTip="Stop writing to log file"
                            IsEnabled="{Binding IsFileLoggingEnabled}"/>
                    <Button Content="🧪 Test" 
                            Command="{Binding SendTestMessageCommand}" 
                            Width="80" Height="35"
                            Background="#9b59b6" Foreground="White" FontWeight="Bold"
                            ToolTip="Send test spot to viewer"
                            Margin="0,0,5,0"
                            IsEnabled="{Binding IsMqttConnected}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Check Interval:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding TimerIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" 
                             Width="50" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="sec" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="ℹ Each filter uses its own NotifyPeriodMinutes"
                               FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">
                        <Run Text="Found:"/>
                        <Run Text="{Binding SpotsFoundToday, Mode=OneWay}" FontWeight="Bold" Foreground="#3498db"/>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Sent:"/>
                        <Run Text="{Binding SpotsSentToday, Mode=OneWay}" FontWeight="Bold" Foreground="#27ae60"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Latest Decision Display -->
        <Border Grid.Row="2" 
                Background="#1a1a2e" 
                CornerRadius="5" 
                Padding="10" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="📋 Latest Decision:" 
                           FontWeight="Bold" Foreground="#f39c12"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1" 
                           Text="{Binding LastDecisionTimestamp, Mode=OneWay}" 
                           Foreground="#95a5a6" FontFamily="Consolas"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="2" 
                           Text="{Binding LastDecisionDisplay, Mode=OneWay}" 
                           Foreground="White" FontFamily="Consolas" FontSize="12"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip="{Binding LastDecisionDisplay}"/>

                <TextBlock Grid.Column="3" 
                           Text="{Binding LogFilePath, StringFormat='📁 {0}'}" 
                           Foreground="#7f8c8d" FontSize="10"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           ToolTip="{Binding LogFilePath}"/>
            </Grid>
        </Border>

        <!-- TabControl for Filters and Users -->
        <TabControl Grid.Row="3">
            <!-- Tab 1: Filters Management -->
            <TabItem Header="🎯 Filters">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox Content="Show All Users" 
                                  IsChecked="{Binding ShowAllUsersFilters}" 
                                  VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <TextBlock Text="User:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding AvailableUsers}" 
                                  SelectedItem="{Binding SelectedFilterUser}"
                                  Width="120"
                                  IsEnabled="{Binding ShowAllUsersFilters, Converter={StaticResource InverseBoolConverter}}"
                                  Margin="0,0,15,0"/>

                        <Button Content="➕ Add Filter" 
                                Command="{Binding AddFilterCommand}"
                                Width="100" Margin="0,0,5,0"/>
                        <Button Content="🗑 Delete" 
                                Command="{Binding DeleteFilterCommand}"
                                CommandParameter="{Binding SelectedFilter}"
                                Width="80"/>
                    </StackPanel>

                    <!-- ✅ FIXED: Filters DataGrid with proper CheckBox binding -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding AllFilters}"
                              SelectedItem="{Binding SelectedFilter}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User" Binding="{Binding UserCall}" Width="80" IsReadOnly="True"/>

                            <!-- DX Call with UPPERCASE -->
                            <DataGridTemplateColumn Header="DX Call" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Callsign}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}" 
                                                 CharacterCasing="Upper" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridComboBoxColumn Header="Mode" SelectedItemBinding="{Binding Mode}" Width="70">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="sys:String">
                                        <sys:String>CW</sys:String>
                                        <sys:String>SSB</sys:String>
                                        <sys:String>FT8</sys:String>
                                        <sys:String>ANY</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>

                            <!-- ✅ FIXED: Enabled checkbox with immediate binding -->
                            <DataGridTemplateColumn Header="Enabled" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Period (min)" Binding="{Binding NotifyPeriodMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80"/>

                            <!-- ✅ FIXED: AnyBand checkbox with immediate binding -->
                            <DataGridTemplateColumn Header="Any Band" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding AnyBand, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="CQ Zones" Binding="{Binding CqZones, UpdateSourceTrigger=PropertyChanged}" Width="80"/>

                            <!-- ✅ FIXED: All band checkboxes with immediate binding -->
                            <DataGridTemplateColumn Header="160m" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Band160m, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="80m" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Band80m, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="40m" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Band40m, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="30m" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Band30m, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="20m" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Band20m, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="17m" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Band17m, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="15m" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Band15m, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="12m" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Band12m, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="10m" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Band10m, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="6m" Width="35">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Band6m, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Users Management -->
            <TabItem Header="👥 Users">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Add User" Command="{Binding AddUserCommand}"
                                Width="100" Margin="0,0,5,0"/>
                        <Button Content="💾 Save Changes" Command="{Binding SaveChangesCommand}"
                                Width="110" Margin="0,0,5,0"
                                Background="#27ae60" Foreground="White"
                                IsEnabled="{Binding HasUnsavedChanges}"/>
                        <Button Content="↩ Cancel" Command="{Binding CancelChangesCommand}"
                                Width="80" Margin="0,0,5,0"
                                IsEnabled="{Binding HasUnsavedChanges}"/>
                        <Button Content="🗑 Delete User" Command="{Binding RemoveUserCommand}"
                                CommandParameter="{Binding SelectedUser}"
                                Width="100" Background="#e74c3c" Foreground="White"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding AllUsers}"
                              SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Callsign" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UserCall}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding UserCall, UpdateSourceTrigger=PropertyChanged}" 
                                                 CharacterCasing="Upper" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PIN" Binding="{Binding PIN}" Width="60"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding UserName}" Width="150"/>
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="200"/>
                            <DataGridTextColumn Header="Filters" Binding="{Binding FilterCount}" Width="60" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Screen Log Header -->
        <Border Grid.Row="4" Background="#2c3e50" CornerRadius="3,3,0,0" 
                Padding="10,5" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ActivityLogHeader}" 
                           Foreground="White" FontWeight="Bold" FontSize="12"/>
                <Button Grid.Column="1" Content="Clear" 
                        Command="{Binding ClearScreenLogCommand}"
                        Width="60" Height="22" FontSize="10"/>
            </Grid>
        </Border>

        <!-- Screen Log DataGrid -->
        <DataGrid Grid.Row="5" 
               IsEnabled="False"
                  ItemsSource="{Binding ScreenLogEntries}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                
                 
                  GridLinesVisibility="Horizontal"
                  FontFamily="Consolas"
                  FontSize="12"
                  BorderThickness="1"
                  BorderBrush="#bdc3c7">
            <!-- Add DataGrid.Resources to override cell background
            The problem is that the DataGridCell elements have their own default style that changes appearance when disabled. 
            You need to override the DataGridCell style to control the background color in the disabled state.
            -->
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <!--<Setter Property="Background" Value="Green"/>-->
                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                    <!--<Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="Blue"/>
                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                        </Trigger>
                    </Style.Triggers>-->
                    
                    
                    
                </Style>
            </DataGrid.Resources>
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Setter Property="Background" Value="red"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>


            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding RowBackground}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="Foreground" Value="{Binding TextColor}"/>
                    <Style.Triggers>
                        <!-- Background by RptByType -->
                        <DataTrigger Binding="{Binding RptByType}" Value="SKM">
                            <Setter Property="Background" Value="#E5F5E1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RptByType}" Value="STN">
                            <Setter Property="Background" Value="#F5E5E5"/>
                        </DataTrigger>
                        <!-- Foreground when DataGrid is disabled -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsEnabled}" Value="False">
                            <Setter Property="Foreground" Value="#112233"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="DX Call" Binding="{Binding DxCall}" Width="70" Foreground="DarkGreen" FontWeight="ExtraBold" FontSize="16"/>
                <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="50" Foreground="DarkGreen" FontWeight="ExtraBold" FontSize="16"/>
                <DataGridTextColumn Header="Local" Binding="{Binding LocalTimeStr}" Width="60" FontWeight="ExtraBold" FontSize="16"/>
                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="50" FontWeight="ExtraBold" FontSize="16"/>
                <DataGridTextColumn Header="Spotter" Binding="{Binding Spotter}" Width="70"  />
                <DataGridTextColumn Header="Type" Binding="{Binding RptByType}" Width="40"/>
                <DataGridTextColumn Header="To User" Binding="{Binding TargetUser}" Width="55" Foreground="DarkGreen"/>
                <DataGridTextColumn Header="UTC" Binding="{Binding UtcTimeStr}" Width="45"/>
                <DataGridTextColumn Header="Freq" Binding="{Binding FrequencyStr}" Width="80"/>
                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="300" Foreground="#223344" FontSize="16"/>
            </DataGrid.Columns>
        </DataGrid>
        <!-- Status Bar -->
        <Border Grid.Row="6" Background="#34495e" CornerRadius="0,0,3,3" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12"/>
        </Border>
    </Grid>
</Window>